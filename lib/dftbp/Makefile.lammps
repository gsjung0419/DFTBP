# Settings that the LAMMPS make-based build will import when the DFTBP
# package is enabled with `make yes-dftbp`.
#
# These variables are intentionally left blank here. A staging helper
# script can populate them for a specific DFTB+ installation, or they
# can be edited manually after copying this package into LAMMPS.
#
# Typical values look like:
# dftbp_SYSLIB = -L/path/to/dftbplus/lib -ldftbplus <extra static-link libs>

dftbp_SYSINC =
dftbp_SYSLIB =
dftbp_SYSPATH =
